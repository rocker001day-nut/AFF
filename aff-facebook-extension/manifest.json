{
  "manifest_version": 3,
  "name": "AFF Facebook Pages",
  "version": "0.4.0",
  "description": "ตรวจบัญชี Facebook และค้นหาเพจที่แสดงใน Chrome สำหรับ AFF",
  "permissions": [
    "cookies",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aff-lyart.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
